<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set siteName = "Travel Notes" %}
    {% set pageTitle = title or siteName %}
    {% if siteName in pageTitle %}
      {% set metadataTitle = pageTitle %}
    {% else %}
      {% set metadataTitle = pageTitle + " | " + siteName %}
    {% endif %}
    <title>{{ metadataTitle }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    <meta property="og:title" content="{{ metadataTitle }}">
    {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
    <meta property="og:type" content="website">
    <link rel="stylesheet" href="{{ '/style.css' | htmlBaseUrl }}">
    {% if isTravelMap %}<link rel="stylesheet" href="{{ '/vendor/leaflet/leaflet.css' | htmlBaseUrl }}">{% endif %}
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="{{ '/' | htmlBaseUrl }}" aria-label="Travel Notes home">Travel Notes</a>
      <nav class="site-nav" aria-label="Primary navigation">
        {% if isTrip %}
          <a href="#essay">Essay</a>
          {% if photos %}<a href="#photographs">Photographs</a>{% endif %}
        {% elif isTravelMap %}
          <a href="{{ '/' | htmlBaseUrl }}#trips">Trips</a>
        {% elif not isAbout and not isProjects %}
          <a href="#trips">Trips</a>
        {% endif %}
        <a href="{{ '/travel-map/' | htmlBaseUrl }}"{% if isTravelMap %} aria-current="page"{% endif %}>Map</a>
        <a href="{{ '/projects/' | htmlBaseUrl }}"{% if isProjects %} aria-current="page"{% endif %}>Projects</a>
        <a href="{{ '/about/' | htmlBaseUrl }}"{% if isAbout %} aria-current="page"{% endif %}>About</a>
      </nav>
    </header>

    <main id="top">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>Travel notes and photographs.</p>
    </footer>

    <script src="{{ '/script.js' | htmlBaseUrl }}"></script>
    {% if isTravelMap %}
      <script src="{{ '/vendor/leaflet/leaflet.js' | htmlBaseUrl }}"></script>
      <script src="{{ '/vendor/leaflet/leaflet.polylineDecorator.js' | htmlBaseUrl }}"></script>
      <script src="{{ '/travel-map.js' | htmlBaseUrl }}"></script>
    {% endif %}
  </body>
</html>
