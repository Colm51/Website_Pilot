{
  "name": "travel-notes",
  "version": "1.0.0",
  "private": true,
  "description": "Travel essays and photographs built with Eleventy.",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/sync-travels.js && node scripts/sync-books.js",
    "start": "eleventy --serve",
    "prebuild": "node scripts/sync-travels.js && node scripts/sync-books.js",
    "build": "eleventy",
    "sync-travels": "node scripts/sync-travels.js --geocode",
    "sync-books": "node scripts/sync-books.js",
    "sync-photos": "node scripts/sync-photos.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-polylinedecorator": "^1.6.0",
    "read-excel-file": "^9.3.10"
  }
}
